// fs2_sfu — the quarter-rate SFU path: RCP RSQRT LOG2 EXP2 on single
// components (the common case) and on whole vec4s, back to back (two in flight, the 4-cycle feeder), with modifiers,
// results used at once by madds (scoreboard on a buffered write), interleaved with other work, a result overwritten by
// a later scheduled write (WAW), STO. Golden: python3 tools/isa64.py fs2 tests/fs2_sfu.sasm --exact-rcp; run tb_fs2
// with +TOL_8 (the reference's RSQRT / LOG2 / EXP2 are approximations; RCP is the exact RTL model).
LDV    r1, 8
LDP    r2, 1
MOVI   r13, #0                       // r13.xz are read below but only .yw / .x get written
MOVI   r3.x, #2.0
MOVI   r3.y, #0.5
MOVI   r3.z, #3.0
MOVI   r3.w, #-1.5
RCP    r4.x, r1.w
RCP    r5, r3
RSQRT  r6.x, !r1.x
MUL    r7, r4.x, r1                  // waits for the buffered RCP result
RSQRT  r8, !r3
ADD    r9, r5, r8
LOG2   r10.xy, r3.xz
EXP2   r10.zw, r3.yx
EXP2   r11, r3.w
MAD    r12, r10, r6.x, r11
RCP    r13.yw, -r3.xx
ADD    r12, r12, r13
MOV    r13.x, r12.y                  // WAW on r13 while its RCP may still be in flight
RCP    r14, r2
RSQRT  r14, r2                       // WAW between two buffered results of different classes
LOG2   r15.x, r2.y
ADD    r16, r14, r15.x
STO    r16.wzyx
END
