// b_fs_sk_reuse — B4 scan test (tb_b_render, BR_SKIPTEST=1): a register that held a texel is written again, whole
// and unconditionally, from the varyings and then used as coordinates (a compiler reusing registers). The scan must
// ALLOW the sample skip.
LDV   r1, 0
TEX   r2, r1, #0
LDV   r3, 1
MUL   r4, r2, r3
MOV   r2, r1
MAD   r2, r3, r3, r2
TEX   r6, r2, #0, BIAS
ADD   r4, r4, r6
STO   0, r4
END
