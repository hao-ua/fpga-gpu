// fs2_dp — the chains: DP3 / DP4 with swizzled sources and modifiers into one component,
// several components and a full vec4; back to back so the accumulators of several warps interleave; a dot product
// whose destination is one of its sources; results used at once (scoreboard on the finals), a DP overwritten by a
// later scheduled write, DP of a DP; the exact (p0 + p1) + (p2 + p3) tree. Golden: python3 tools/isa64.py fs2 tests/fs2_dp.sasm
LDV    r1, 8
LDP    r2, 0
MOVI   r3.x, #1.0
MOVI   r3.y, #2.0
MOVI   r3.z, #-3.0
MOVI   r3.w, #0.5
DP4    r4.x, r1, r2
DP3    r4.y, r1, r3
DP4    r4.zw, r3.wzyx, -r1
DP3    r5, r1.yzwx, !r3
DP4    r6, r3, r3
MUL    r7, r4.x, r5                  // waits for the finals
DP4    r1.x, r1, r3                  // destination is a source: all products read before the write
DP3    r8.xz, r1.wzy, r2.zyx
DP4    r8.yw, r8.xzxz, r3
ADD    r9, r4, r6
DP4    r9.w, r9, r2                  // RAW on r9, WAW on r9.w
DP3    r10.x, r7, r5
MOV    r10.yzw, r10.x
DP4    r11.x, r10, r1
STO    r11.xxxx
END
