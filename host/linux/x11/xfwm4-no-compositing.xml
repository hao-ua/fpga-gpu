<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml: XFCE's window manager without its compositor. Compositing
     repaints the screen through the boards for every change of any window; without it windows draw straight into
     the screen. The other window-manager settings keep their defaults. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
  </property>
</channel>
