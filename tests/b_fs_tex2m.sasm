// b_fs_tex2m — b_fs_tex2 as the compilers emit it (LDV write masks, the TEX .xy coordinate set): OpenArena's world
// shader, diffuse (sampler 0 at varying 0) times lightmap (sampler 1 at varying 1).
LDV   r1.xy, 0
TEX   r2, r1, #0, .xy
LDV   r3.xy, 1
TEX   r4, r3, #1, .xy
MUL   r5, r2, r4
STO   0, r5
END
