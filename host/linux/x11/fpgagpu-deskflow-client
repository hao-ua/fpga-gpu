#!/bin/sh
# /usr/local/bin/fpgagpu-deskflow-client NAME SERVER: the session's Deskflow client (screen NAME of the server at
# SERVER), started again whenever it stops (it gives up when its connection dies: its own reconnecting can hang after
# the server restarts), for as long as the session's X answers. A loop or client an earlier session left behind (the
# display manager restarted: user processes outlive their session) is stopped first, by the PIDs it recorded: two
# clients of one name take turns at the server
name=$1
server=$2
f=${XDG_RUNTIME_DIR:-/tmp}/fpgagpu-deskflow-client.pids

if [ -f "$f" ]; then
	while read -r p c; do
		[ "$p" != "$$" ] && [ "$(cat /proc/"$p"/comm 2>/dev/null)" = "$c" ] && kill "$p" 2>/dev/null
	done < "$f"
fi
me="$$ $(cat /proc/$$/comm)"
echo "$me" > "$f"
while xset q > /dev/null 2>&1; do
	deskflow-client --no-daemon --no-restart --name "$name" --enable-crypto "$server" &
	printf '%s\n%s deskflow-client\n' "$me" "$!" > "$f"
	wait $!
	sleep 2
done
