// b_fs_sk_dep — B4 scan test (tb_b_render, BR_SKIPTEST=1): a dependent read — the second fetch's coordinates come
// from the first fetch's texels, so an uncovered pixel's texel changes the covered pixels' level of detail.
// The scan must REFUSE the sample skip for this program.
LDV   r1, 0
TEX   r2, r1, #0
LDV   r3, 1
MAD   r5, r2, r3, r1
TEX   r6, r5, #0
ADD   r4, r2, r6
STO   0, r4
END
